# ===== TTS PROVIDER =====
# edge: Edge TTS online, miễn phí | cit: CIT Voice Studio offline (mở app trước)
TTS_PROVIDER=edge
TTS_OUTPUT_DIR=public/audio

# ===== EDGE TTS (TTS_PROVIDER=edge) =====
# Giọng: vi-VN-HoaiMyNeural (nữ), vi-VN-NamMinhNeural (nam), en-US-JennyNeural, en-US-GuyNeural...
EDGE_TTS_VOICE=vi-VN-HoaiMyNeural
EDGE_TTS_RATE=+10%        # -50% → +100%
EDGE_TTS_PITCH=+0Hz       # -50Hz → +50Hz
EDGE_TTS_VOLUME=+0%       # -50% → +100%

# ===== CIT VOICE STUDIO (TTS_PROVIDER=cit) =====
# Tải app: https://github.com/Cuongyd196/cit-voice-studio
# Xem thêm giọng & tham số: docs/cit-voice-studio.md
CIT_TTS_BASE_URL=http://127.0.0.1:8001
CIT_TTS_API_KEY=          # chỉ cần khi gọi từ máy khác / tunnel
CIT_TTS_VOICE=Hải Đăng    # trống = giọng mặc định; xem GET /voices
CIT_TTS_SPEED=1.1         # 0.5 → 2.0
CIT_TTS_TEMPERATURE=0.7   # 0.1 → 1.2, độ biểu cảm
CIT_TTS_FORMAT=wav        # wav | mp3
CIT_TTS_LANGUAGE=         # en, ja, ko... (chỉ Supertonic 3); trống = tự nhận
CIT_TTS_SEED=             # cố định để audio lặp lại giống nhau
CIT_TTS_USE_PRONUNCIATION_DICT=true
CIT_TTS_TIMEOUT_SEC=120

# ===== BRANDING =====
CHANNEL_NAME="CƯỜNG IT"

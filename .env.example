# ==============================================================================
# CẤU HÌNH GIỌNG ĐỌC EDGE TTS (edge-tts-universal)
# ==============================================================================

# Giọng đọc mặc định (Voice ID).
# Các giọng tiếng Việt phổ biến:
# - vi-VN-HoaiMyNeural (Nữ - Truyền cảm, tự nhiên)
# - vi-VN-NamMinhNeural (Nam - Trầm ấm, rõ ràng)
#
# Các giọng tiếng Anh phổ biến:
# - en-US-ChristopherNeural (Nam - Kể chuyện, tự nhiên)
# - en-US-GuyNeural (Nam - Tin tức, đĩnh đạc)
# - en-US-JennyNeural (Nữ - Thân thiện)
# - en-US-AriaNeural (Nữ - Trẻ trung, năng động)
# - en-US-AndrewNeural (Nam - Sâu lắng)
#
# Các ngôn ngữ khác:
# - ja-JP-NanamiNeural (Tiếng Nhật - Nữ)
# - zh-CN-XiaoxiaoNeural (Tiếng Trung - Nữ)
# - ko-KR-SunHiNeural (Tiếng Hàn - Nữ)
EDGE_TTS_VOICE=vi-VN-HoaiMyNeural

# Tốc độ đọc (Rate): Giá trị từ -50% đến +100% (Ví dụ: +0%, +10%, +15%)
# Video ngắn 50-60s nên dùng tốc độ +10% hoặc +15% để giọng nói nhanh, cuốn hút
EDGE_TTS_RATE=+10%

# Cao độ giọng đọc (Pitch): Giá trị từ -50Hz đến +50Hz (Ví dụ: +0Hz, +2Hz)
EDGE_TTS_PITCH=+0Hz

# Âm lượng giọng đọc (Volume): Giá trị từ -50% đến +100% (Ví dụ: +0%, +10%)
EDGE_TTS_VOLUME=+0%

# Thư mục xuất file audio (mặc định: public/audio)
EDGE_TTS_OUTPUT_DIR=public/audio

# ==============================================================================
# THƯƠNG HIỆU KÊNH (BRANDING)
# ==============================================================================
# Tên kênh hiển thị phía trên ở giữa video
CHANNEL_NAME="CƯỜNG IT"

